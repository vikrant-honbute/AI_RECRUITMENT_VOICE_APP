# Neon Postgres connection string
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Clerk authentication
# Find these in the Clerk Dashboard: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# From Clerk Dashboard -> Webhooks -> "Signing Secret"
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

# Clerk page URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# Murf.ai Falcon 2 streaming TTS
# Find your key at: https://murf.ai/api/dashboard
MURF_API_KEY=
# Any Falcon 2 voice (e.g. Gordon, Natalie, Will): https://murf.ai/api/docs/voices-styles/voice-library
MURF_VOICE_ID="Gordon"

# Google AI Studio (Gemini) — powers question generation + interview summaries
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
